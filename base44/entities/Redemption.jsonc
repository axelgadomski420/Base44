{
  "name": "Redemption",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "reward_key": {
      "type": "string"
    },
    "reward_label": {
      "type": "string"
    },
    "cost": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "applied",
        "pending"
      ],
      "enumColors": [
        "green",
        "yellow"
      ],
      "default": "applied"
    },
    "target_id": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "reward_key",
    "cost"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
