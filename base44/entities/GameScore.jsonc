{
  "name": "GameScore",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "game": {
      "type": "string",
      "enum": [
        "2048",
        "memory",
        "quiz",
        "puzzle"
      ],
      "enumColors": [
        "purple",
        "blue",
        "green",
        "yellow"
      ]
    },
    "score": {
      "type": "number"
    },
    "coins_earned": {
      "type": "number"
    },
    "duration_ms": {
      "type": "number"
    }
  },
  "required": [
    "game",
    "score"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
