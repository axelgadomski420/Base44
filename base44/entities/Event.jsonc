{
  "name": "Event",
  "type": "object",
  "properties": {
    "title": { "type": "string" },
    "description": { "type": "string" },
    "location": { "type": "string" },
    "city": { "type": "string" },
    "lat": { "type": "number" },
    "lng": { "type": "number" },
    "start_date": { "type": "string", "format": "date-time" },
    "end_date": { "type": "string", "format": "date-time" },
    "price_coins": { "type": "number", "default": 0 },
    "cover_url": { "type": "string" },
    "organizer_id": { "type": "string" },
    "status": { "type": "string", "enum": ["draft", "published", "cancelled"], "default": "draft" }
  },
  "required": ["title", "start_date", "organizer_id"],
  "rls": {
    "read": {},
    "create": { "created_by_id": "{{user.id}}" },
    "update": { "$or": [{ "created_by_id": "{{user.id}}" }, { "user_condition": { "role": "admin" } }] },
    "delete": { "$or": [{ "created_by_id": "{{user.id}}" }, { "user_condition": { "role": "admin" } }] }
  }
}
