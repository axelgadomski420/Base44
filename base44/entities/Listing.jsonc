{
  "name": "Listing",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "sale",
        "adoption"
      ],
      "enumColors": [
        "blue",
        "green"
      ],
      "default": "sale"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "species": {
      "type": "string",
      "enum": [
        "dog",
        "cat"
      ],
      "enumColors": [
        "blue",
        "pink"
      ]
    },
    "breed": {
      "type": "string"
    },
    "age_months": {
      "type": "number"
    },
    "sex": {
      "type": "string",
      "enum": [
        "male",
        "female"
      ],
      "enumColors": [
        "blue",
        "pink"
      ]
    },
    "city": {
      "type": "string"
    },
    "lat": {
      "type": "number"
    },
    "lng": {
      "type": "number"
    },
    "image_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "seller_id": {
      "type": "string"
    },
    "seller_name": {
      "type": "string"
    },
    "seller_verified": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "review",
        "sold",
        "archived"
      ],
      "enumColors": [
        "green",
        "yellow",
        "blue",
        "gray"
      ],
      "default": "active"
    },
    "boosted_until": {
      "type": "string",
      "format": "date-time"
    },
    "risk": {
      "type": "number"
    },
    "moderation_note": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "city"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.status": {
            "$in": [
              "active",
              "sold"
            ]
          }
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
