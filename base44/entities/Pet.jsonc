{
  "name": "Pet",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string"
    },
    "owner_name": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "species": {
      "type": "string",
      "enum": [
        "dog",
        "cat"
      ],
      "enumColors": [
        "blue",
        "pink"
      ]
    },
    "breed": {
      "type": "string"
    },
    "birth_date": {
      "type": "string",
      "format": "date"
    },
    "color": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pedigree": {
      "type": "boolean"
    },
    "city": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
