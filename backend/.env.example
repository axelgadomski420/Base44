# --- Database ---
# PostgreSQL on the same Oracle server
DATABASE_URL="postgresql://purre:purre_secret@127.0.0.1:5432/purrepets?schema=public"

# --- Security ---
# Generate with: openssl rand -hex 48
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# --- Server ---
PORT=4000
HOST=127.0.0.1
NODE_ENV=production

# --- Public URLs / CORS ---
PUBLIC_BASE_URL="http://92.5.154.243"
CORS_ORIGINS="http://92.5.154.243,https://purrepets.pl"

# --- Uploads ---
UPLOAD_DIR="uploads"
MAX_UPLOAD_BYTES=26214400

# --- Optional SMTP (registration OTP codes) ---
# When empty, codes are printed to the server log (and returned by the API
# outside production). Configure before going live.
#SMTP_HOST="smtp.example.com"
#SMTP_PORT=587
#SMTP_SECURE="false"
#SMTP_USER="no-reply@purrepets.pl"
#SMTP_PASS="smtp-password"
#SMTP_FROM="PURRE PETS <no-reply@purrepets.pl>"

# --- Optional LLM for moderation / assistant (replaces Base44 InvokeLLM) ---
#MODERATION_LLM_URL="https://api.mistral.ai/v1/chat/completions"
#MODERATION_LLM_KEY=""
#ASSISTANT_LLM_URL="https://api.mistral.ai/v1/chat/completions"
#ASSISTANT_LLM_KEY=""
