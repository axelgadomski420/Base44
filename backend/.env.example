# --- Stripe (pakiety PURRE Coins). Puste = sklep pokazuje pakiety, ale nie otwiera płatności. ---
STRIPE_SECRET_KEY="sk_test_51SxozQQxBCoqekEnSeUF6VnBm0K8PHqUO9jQ292ybqbCXgNze1Sr3vHgNf1V1RHrBtxpkTHxckFPgxTn6fKDsO5p00LfES42GX"
